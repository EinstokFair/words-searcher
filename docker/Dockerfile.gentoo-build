FROM gentoo/stage3:latest AS sync

# Стадия 1: дерево Portage + патч gpkg (deadlock xz-gpkg, bug 983992/984140)
RUN emerge-webrsync
COPY docker/gpkg-drain-stdout.patch /tmp/gpkg-drain-stdout.patch
RUN cd /usr/lib/python3.14/site-packages/portage && \
    cp gpkg.py gpkg.py.bak && \
    patch -p2 < /tmp/gpkg-drain-stdout.patch && \
    rm -f /tmp/gpkg-drain-stdout.patch

FROM sync AS autotools
# Стадия 2: Autotools
RUN emerge -v --getbinpkgonly --oneshot \
      dev-build/autoconf \
      dev-build/automake \
      dev-build/libtool

FROM autotools AS qt

# USE: qtbase -gtk (рвём gtk+ -> at-spi2-core -> libXtst -> libXi[abi_x86_32]);
# libxkbcommon X — совпасть с binhost при --binpkg-respect-use=y
RUN mkdir -p /etc/portage/package.use \
 && printf "dev-qt/qtbase -gtk\nx11-libs/libxkbcommon X\n" > /etc/portage/package.use/qtbase

# Стадия 3: Qt6. --binpkg-respect-use=y — сверять USE с binhost (иначе берётся qtbase с gtk)
RUN emerge -v --binpkg-respect-use=y --getbinpkgonly --oneshot \
      dev-qt/qtbase:6 \
      dev-qt/qttools:6[linguist] \
      dev-qt/qttranslations:6

FROM qt AS glib
# Стадия 4: glib / gobject-introspection (USE до emerge)
RUN mkdir -p /etc/portage/package.use \
 && printf "dev-libs/gobject-introspection -doctool -gtk-doc -test\n" \
      > /etc/portage/package.use/gobject-introspection
RUN emerge -v --getbinpkgonly --oneshot \
      dev-libs/glib \
      dev-libs/gobject-introspection

FROM glib AS final
# Стадия 5: остальное
RUN emerge -v --getbinpkgonly --oneshot \
      dev-build/make \
      dev-util/pkgconf

ENV FEATURES="buildpkg"
ENV EMERGE_DEFAULT_OPTS="--binpkg-respect-use=n"

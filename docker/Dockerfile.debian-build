FROM debian:trixie-slim

# Один образ для build:dist и build:debian.
# Сначала проверить в интерактивном контейнере, потом записывать сюда.

# Слой 1: базовые инструменты для make dist
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      autoconf automake libtool pkg-config \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Слой 2: Qt6 для сборки (moc, rcc, lupdate, lrelease)
RUN apt-get update && apt-get install -y --no-install-recommends \
      qt6-base-dev qt6-base-dev-tools qt6-l10n-tools \
 && rm -rf /var/lib/apt/lists/*

# Слой 3: для dpkg-buildpackage и перевода стандартных кнопок
RUN apt-get update && apt-get install -y --no-install-recommends \
      qt6-translations-l10n debhelper dpkg-dev \
 && rm -rf /var/lib/apt/lists/*
